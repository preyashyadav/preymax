{
  // Default name for EVERY terminal in this project, including ones opened
  // with the plain `+`. Without this, an un-profiled terminal falls back to
  // basename(cwd)+branch and you can't tell it apart from any other session.
  "terminal.integrated.env.osx": { "PREYMAX_NAME": "preymax" },

  // Dogfood: named terminal profiles for preymax's own development.
  // These override the default above. Copy this pattern into your own
  // projects — see docs/vscode.md.
  "terminal.integrated.profiles.osx": {
    "daemon": {
      "path": "/bin/zsh",
      "args": ["-l"],
      "env": { "PREYMAX_NAME": "daemon" },
      "icon": "server-process",
      "color": "terminal.ansiCyan"
    },
    "tests": {
      "path": "/bin/zsh",
      "args": ["-l"],
      "env": { "PREYMAX_NAME": "tests" },
      "icon": "beaker",
      "color": "terminal.ansiGreen"
    },
    "docs": {
      "path": "/bin/zsh",
      "args": ["-l"],
      "env": { "PREYMAX_NAME": "docs" },
      "icon": "book",
      "color": "terminal.ansiYellow"
    }
  },
  "typescript.tsdk": "node_modules/typescript/lib"
}
